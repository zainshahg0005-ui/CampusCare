PORT=5000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/campuscare?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173

# Email & Notification Settings (Gmail SMTP or Resend)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_google_app_password
EMAIL_FROM=CampusCare <your_email@gmail.com>
RESEND_API_KEY=re_your_resend_api_key_here

# Cloudinary Storage for Complaint Media Attachments
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Seed Admin Account
ADMIN_EMAIL=admin@campuscare.edu
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=Campus Administrator
ADMIN_ID=ADMIN01
